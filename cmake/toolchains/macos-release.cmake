# Isolated macOS release dependencies; build tools may still come from Homebrew.
set(SUNSHINE_MACOS_DEPS "$ENV{CANVASHOST_MACOS_DEPS}" CACHE PATH "macOS release dependencies")
if(NOT EXISTS "${SUNSHINE_MACOS_DEPS}/manifest.json")
    message(FATAL_ERROR "Build the release dependencies with scripts/macos-deps/prepare.py first.")
endif()
set(CMAKE_C_COMPILER /usr/bin/clang CACHE FILEPATH "C compiler")
set(CMAKE_CXX_COMPILER /usr/bin/clang++ CACHE FILEPATH "C++ compiler")
set(CMAKE_OBJC_COMPILER /usr/bin/clang CACHE FILEPATH "Objective-C compiler")
set(CMAKE_OBJCXX_COMPILER /usr/bin/clang++ CACHE FILEPATH "Objective-C++ compiler")
set(CMAKE_OSX_DEPLOYMENT_TARGET "14.4" CACHE STRING "Minimum macOS version")
set(CMAKE_OSX_ARCHITECTURES "arm64" CACHE STRING "Release architecture")
if(CMAKE_OSX_DEPLOYMENT_TARGET VERSION_LESS "14.4" OR NOT CMAKE_OSX_ARCHITECTURES STREQUAL "arm64")
    message(FATAL_ERROR "Release dependencies require macOS 14.4 or newer and arm64.")
endif()
execute_process(COMMAND xcrun --sdk macosx --show-sdk-path
    OUTPUT_VARIABLE _release_sdk OUTPUT_STRIP_TRAILING_WHITESPACE COMMAND_ERROR_IS_FATAL ANY)
set(CMAKE_OSX_SYSROOT "${_release_sdk}" CACHE PATH "macOS SDK")
set(CMAKE_PREFIX_PATH "${SUNSHINE_MACOS_DEPS}" CACHE STRING "Release prefix" FORCE)
set(CMAKE_FIND_ROOT_PATH "${SUNSHINE_MACOS_DEPS};${CMAKE_OSX_SYSROOT}")
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_USE_PACKAGE_REGISTRY OFF)
set(CMAKE_FIND_USE_SYSTEM_PACKAGE_REGISTRY OFF)
set(CMAKE_IGNORE_PREFIX_PATH "/opt/homebrew;/opt/local;/usr/local")
set(ENV{PKG_CONFIG_PATH} "")
set(ENV{PKG_CONFIG_LIBDIR} "${SUNSHINE_MACOS_DEPS}/lib/pkgconfig")
set(OPENSSL_ROOT_DIR "${SUNSHINE_MACOS_DEPS}" CACHE PATH "OpenSSL prefix" FORCE)
set(Opus_ROOT_DIR "${SUNSHINE_MACOS_DEPS}" CACHE PATH "Opus prefix" FORCE)
set(Qt6_DIR "${SUNSHINE_MACOS_DEPS}/lib/cmake/Qt6" CACHE PATH "Qt prefix" FORCE)
set(Qt6Svg_DIR "${SUNSHINE_MACOS_DEPS}/lib/cmake/Qt6Svg" CACHE PATH "Qt SVG prefix" FORCE)
set(BOOST_USE_STATIC ON CACHE BOOL "Static Boost" FORCE)
